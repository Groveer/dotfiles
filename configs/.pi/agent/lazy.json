{
  "version": 1,
  "defaults": {
    "lazy": true
  },
  "auto": true,
  "autoLoadLimit": 1,
  "afterStartBatchSize": 1,
  "afterStartDelayMs": 0,
  "afterStartInitialDelayMs": 750,
  "afterStartPauseDuringTurn": true,
  "afterStartAdaptiveYield": true,
  "afterStartPrefetch": true,
  "specs": [
    {
      "name": "tui",
      "source": "npm:pi-open-tui",
      "lazy": "after-start",
      "priority": 10,
      "description": "TUI / terminal user interface"
    },
    {
      "name": "history",
      "source": "npm:pi-input-history",
      "lazy": "after-start",
      "priority": 30,
      "description": "Input history and recall"
    },
    {
      "name": "todo",
      "source": "npm:@juicesharp/rpiv-todo",
      "lazy": true,
      "cmd": [
        "todo"
      ],
      "tools": [
        "todo"
      ],
      "keywords": [
        "todo",
        "task",
        "task management"
      ],
      "description": "Todo / task management"
    },
    {
      "name": "remote",
      "source": "npm:pi-ssh-remote",
      "lazy": true,
      "cmd": [
        "remote"
      ],
      "keywords": [
        "ssh",
        "remote"
      ],
      "description": "ssh / remote"
    },
    {
      "name": "ask-user",
      "source": "npm:@juicesharp/rpiv-ask-user-question",
      "lazy": "after-start",
      "priority": 20,
      "tools": [
        "ask_user_question"
      ]
    },
    {
      "name": "file-preview",
      "source": "npm:pi-file-preview",
      "lazy": "after-start",
      "priority": 20
    },
    {
      "name": "theme",
      "source": "npm:@spences10/pi-themes",
      "lazy": true,
      "description": "Themes"
    },
    {
      "name": "web",
      "source": "npm:pi-web-access",
      "lazy": true,
      "cmd": [
        "web"
      ],
      "tools": [
        "web_search",
        "fetch_content",
        "get_search_content"
      ],
      "keywords": [
        "web search",
        "search the web",
        "fetch url",
        "youtube"
      ],
      "description": "Web search / fetch / video"
    },
    {
      "name": "lens",
      "source": "npm:pi-lens",
      "lazy": true,
      "cmd": [
        "lens-toggle",
        "lens-context-toggle",
        "lens-widget-toggle",
        "lens-health",
        "lens-perf",
        "lens-allow-edit",
        "lens-tools",
        "lens-tdi",
        "lens-map"
      ],
      "tools": [
        "lens_diagnostics",
        "lens_diagnostic_mark",
        "lsp_navigation",
        "ast_grep_search",
        "ast_grep_replace",
        "ast_grep_outline",
        "symbol_search",
        "module_report",
        "read_symbol",
        "read_enclosing",
        "lens_health",
        "lens_project_scan"
      ],
      "keywords": [
        "diagnostics",
        "symbol search",
        "ast-grep",
        "lsp"
      ],
      "description": "pi-lens code intelligence"
    },
    {
      "name": "vision",
      "source": "npm:@getpipher/vision",
      "lazy": true,
      "cmd": [
        "vision",
        "vision-use"
      ],
      "tools": [
        "describe_image"
      ],
      "keywords": [
        "image",
        "vision"
      ],
      "description": "Vision / image reading"
    },
    {
      "name": "find",
      "source": "npm:@ff-labs/pi-fff",
      "lazy": true,
      "cmd": [
        "fff-mode",
        "fff-health",
        "fff-rescan"
      ],
      "tools": [
        "fffind",
        "ffgrep"
      ],
      "keywords": [
        "find",
        "grep"
      ],
      "description": "Find / grep"
    },
    {
      "name": "plannotator",
      "source": "npm:@plannotator/pi-extension",
      "lazy": true,
      "cmd": [
        "plannotator-plan-mode",
        "plannotator-review",
        "plannotator-annotate",
        "plannotator-last"
      ],
      "keywords": [
        "review",
        "plan mode"
      ],
      "description": "Plan mode / review / annotate"
    },
    {
      "name": "hindsight",
      "source": "npm:@luxusai/pi-hindsight",
      "lazy": "after-start",
      "priority": 30,
      "cmd": [
        "hindsight"
      ],
      "tools": [
        "hindsight_bank",
        "hindsight_config",
        "hindsight_knowledge",
        "hindsight_mental_model",
        "hindsight_recall",
        "hindsight_reflect",
        "hindsight_retain",
        "hindsight_retain_global",
        "hindsight_scope",
        "hindsight_scope_migrate",
        "hindsight_seed_git",
        "hindsight_status"
      ],
      "keywords": [
        "hindsight",
        "memory"
      ],
      "description": "Hindsight memory"
    },
    {
      "name": "ponytail",
      "source": "npm:@dietrichgebert/ponytail",
      "lazy": "after-start",
      "priority": 30,
      "cmd": [
        "ponytail",
        "ponytail-review",
        "ponytail-audit",
        "ponytail-gain",
        "ponytail-debt",
        "ponytail-help"
      ],
      "keywords": [
        "ponytail",
        "audit"
      ],
      "description": "Ponytail audit and review"
    }
  ]
}
